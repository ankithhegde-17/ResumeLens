# Start locally without cloud credentials. Use supabase after following docs/SUPABASE_SETUP.md.
APP_MODE=demo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Blank creates a persistent random key in instance/secret.key on first start.
SECRET_KEY=
# auto uses Ollama when its model is available, otherwise RapidOCR. ocr and vlm also work.
EXTRACTION_ENGINE=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=180
PORT=5000
# For a local Windows demo leave false. Enable only behind HTTPS when hosting.
COOKIE_SECURE=false

# Optional server-only Career AI. Never put a real key in source/frontend code.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=25

# Vercel only: also set APP_MODE=supabase, COOKIE_SECURE=true,
# EXTRACTION_ENGINE=ocr, and a strong SECRET_KEY in the Vercel dashboard.
# Run database/vercel_rest_runtime_migration.sql first. Set the legacy
# service_role JWT ONLY in Vercel environment variables, never local source.
# SUPABASE_SERVICE_ROLE_KEY is intentionally not populated in this file.
# Hosted scans/images use the private OCR container. Text PDFs stay on Vercel.
OCR_SERVICE_URL=
OCR_SERVICE_SECRET=
