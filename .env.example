# Direct anonymous usage: no Supabase or authentication keys needed.
# Local development creates instance/secret.key if this is blank.
SECRET_KEY=
COOKIE_SECURE=false
EXTRACTION_ENGINE=auto
PORT=5000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=180
# Optional server-only Gemini Career AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=25
# Hosted image/scanned PDF OCR; not needed for text PDFs or local OCR.
OCR_SERVICE_URL=
OCR_SERVICE_SECRET=
# Vercel: set stable SECRET_KEY, COOKIE_SECURE=true, EXTRACTION_ENGINE=ocr.
