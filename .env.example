# Start locally without cloud credentials. Use supabase after following docs/SUPABASE_SETUP.md.
APP_MODE=demo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Blank creates a persistent random key in instance/secret.key on first start.
SECRET_KEY=
# auto uses Ollama when its model is available, otherwise RapidOCR. ocr and vlm also work.
EXTRACTION_ENGINE=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=180
PORT=5000
# For a local Windows demo leave false. Enable only behind HTTPS when hosting.
COOKIE_SECURE=false

# Optional server-only Career AI. Never put a real key in source/frontend code.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=25
